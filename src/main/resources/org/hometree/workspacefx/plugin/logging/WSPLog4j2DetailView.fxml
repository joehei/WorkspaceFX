<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<fx:root type="VBox" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="5.0" VBox.vgrow="NEVER">
         <children>
            <StackPane fx:id="iconPane" minWidth="20.0" />
            <Label fx:id="ts" text="Timestamp" />
            <Region HBox.hgrow="ALWAYS" />
            <FontIcon fx:id="closeIcon" iconLiteral="mdi2c-close-box-outline" iconSize="16" />
         </children>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </HBox>
      <SplitPane dividerPositions="0.20506108202443277" orientation="VERTICAL" VBox.vgrow="ALWAYS">
         <items>
            <TextArea fx:id="message" editable="false" />
            <TextArea fx:id="exception" editable="false" />
         </items>
      </SplitPane>
   </children>
</fx:root>
