<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>


<VBox fx:id="controlsVBox" spacing="5.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox spacing="5.0">
         <children>
            <TextField fx:id="directory" HBox.hgrow="ALWAYS" />
            <Button fx:id="directorySelector" maxHeight="1.7976931348623157E308" mnemonicParsing="false">
               <graphic>
                  <FontIcon iconLiteral="mdi2f-folder-open-outline" iconSize="16" />
               </graphic>
            </Button>
         </children>
      </HBox>
      <ListView fx:id="fileList" VBox.vgrow="ALWAYS" />
   </children>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
</VBox>
